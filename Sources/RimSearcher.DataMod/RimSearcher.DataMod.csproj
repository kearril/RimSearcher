<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>Latest</LangVersion>
    <Version>3.3.0</Version>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\RimSearcher_DataMod\1.7\Assemblies</OutputPath>
    <NativeOutputPath Condition="'$(NativeOutputPath)' == ''">..\..\RimSearcher_DataMod\Native\</NativeOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.*-*" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.*" />
    <PackageReference Include="SQLitePCLRaw.core" Version="2.1.*" />
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.*" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.*" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <Target Name="CopySqliteNative" AfterTargets="Build">
    <ItemGroup>
      <NativeRuntime Include="$(PkgSQLitePCLRaw_lib_e_sqlite3)\runtimes\win-x64\native\e_sqlite3.dll" />
      <NativeRuntime Include="$(PkgSQLitePCLRaw_lib_e_sqlite3)\runtimes\linux-x64\native\libe_sqlite3.so" />
      <NativeRuntime Include="$(PkgSQLitePCLRaw_lib_e_sqlite3)\runtimes\osx-x64\native\libe_sqlite3.dylib" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeRuntime)"
      DestinationFolder="$(NativeOutputPath)"
      SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(PkgSQLitePCLRaw_lib_e_sqlite3)\runtimes\osx-arm64\native\libe_sqlite3.dylib"
      DestinationFiles="$(NativeOutputPath)\libe_sqlite3.arm64.dylib"
      SkipUnchangedFiles="true" />
  </Target>

</Project>